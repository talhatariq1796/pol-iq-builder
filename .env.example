# Anthropic Claude API Key (powers AI chat)
ANTHROPIC_API_KEY=

# ArcGIS API Key — single key for map, search, and GeoEnrichment (Census infographics)
# Get one at: https://developers.arcgis.com/api-keys/
NEXT_PUBLIC_ARCGIS_API_KEY=

# Claude model (optional). Defaults to Haiku 4.5 snapshot claude-haiku-4-5-20251001
CLAUDE_MODEL=

# =============================================================================
# State Configuration — single lever to switch states
# =============================================================================
# Valid values: pennsylvania | california
# Changing this one variable switches the entire app to a different state.
# All paths, map defaults, county FIPS, boundary layers, and election dates
# are driven by the state config at lib/config/states/<value>.ts
ACTIVE_STATE=pennsylvania

# Legacy per-field overrides (still respected; use ACTIVE_STATE instead when possible)
# POLITICAL_REPORT_STATE=Pennsylvania
# POLITICAL_REPORT_COUNTY=Statewide
# POLITICAL_STATE_FIPS=42
# POLITICAL_SUMMARY_AREA_NAME=Pennsylvania
